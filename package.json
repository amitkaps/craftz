{
  "name": "@amitkaps/craftz",
  "version": "0.0.0",
  "description": "One way every repository builds, checks, deploys and releases, and the repository that shows it working.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/craftz.git"
  },
  "bin": {
    "craftz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/rules.md",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "verify": "pnpm check && pnpm prose check && pnpm test && pnpm build",
    "fix": "vp check --fix",
    "prose": "prose",
    "pr": "node scripts/pr.ts",
    "gone": "node scripts/gone.ts",
    "prepack": "pnpm run build",
    "drift": "node src/drift.ts",
    "craftz": "node src/cli.ts",
    "align": "node src/align.ts",
    "new": "node src/new.ts",
    "release": "node src/release.ts"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.8.0",
    "@mdn/browser-compat-data": "^8.1.6",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.18",
    "publint": "^0.3.25",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.13.0"
}
