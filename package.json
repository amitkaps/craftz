{
  "name": "@amitkaps/craftz",
  "version": "0.3.0",
  "description": "craftz — one way to build, check, deploy and release.",
  "homepage": "https://craftz.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/craftz.git"
  },
  "bin": {
    "craftz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/rules.md",
    "reference",
    "tsconfig.base.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.base.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "verify": "pnpm check && pnpm prose check && pnpm craftz check && pnpm test && pnpm build && pnpm prose build && vp build",
    "ship": "node src/cli.ts deploy",
    "fix": "vp check --fix",
    "prose": "prose",
    "pr": "node src/cli.ts pr",
    "gone": "node src/cli.ts gone",
    "prepack": "pnpm run build",
    "craftz": "node src/cli.ts",
    "align": "node src/align.ts",
    "bump": "node src/align.ts craftz",
    "new": "node src/cli.ts new"
  },
  "devDependencies": {
    "@amitkaps/prose": "0.8.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@mdn/browser-compat-data": "^8.1.7",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.20",
    "publint": "0.3.25",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "vite-plus": "^1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.13.0"
}
